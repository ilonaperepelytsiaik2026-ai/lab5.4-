#include <iostream>
#include <cmath>

using namespace std;

// 5) Ітераційний спосіб (для контролю)
double S0(const int K, const int N) {
    double s = 0;
    for (int k = K; k <= N; k++) {
        s += (1.0 + sqrt(1.0 + k * k)) / (k * k);
    }
    return s;
}

// 1) Рекурсивний спуск, параметр у рекурсивних викликах — зростає (від K до N)
double S1(const int K, const int N, const int i) {
    if (i > N)
        return 0;
    else
        return (1.0 + sqrt(1.0 + i * i)) / (i * i) + S1(K, N, i + 1);
}

// 2) Рекурсивний спуск, параметр у рекурсивних викликах — спадає (від N до K)
double S2(const int K, const int N, const int i) {
    if (i < K)
        return 0;
    else
        return (1.0 + sqrt(1.0 + i * i)) / (i * i) + S2(K, N, i - 1);
}

// 3) Рекурсивний підйом, параметр у рекурсивних викликах — зростає (від K до N)
double S3(const int K, const int N, const int i, double t) {
    t = t + (1.0 + sqrt(1.0 + i * i)) / (i * i);
    if (i >= N)
        return t;
    else
        return S3(K, N, i + 1, t);
}

// 4) Рекурсивний підйом, параметр у рекурсивних викликах — спадає (від N до K)
double S4(const int K, const int N, const int i, double t) {
    t = t + (1.0 + sqrt(1.0 + i * i)) / (i * i);
    if (i <= K)
        return t;
    else
        return S4(K, N, i - 1, t);
}

#include <cassert> // Додайте цей include на початку файлу

void runUnitTest() {
    double eps = 1e-5;
    // S0, S1, S2 берут 3 аргумента; S3 и S4 берут 4 аргумента (с начальным sum = 0)
    assert(abs(S0(1, 15) - S1(1, 15, 1)) < eps);
    assert(abs(S0(1, 15) - S2(1, 15, 15)) < eps);
    assert(abs(S0(1, 15) - S3(1, 15, 1, 0)) < eps);
    assert(abs(S0(1, 15) - S4(1, 15, 15, 0)) < eps);

    std::cout << "[UNIT TEST PASSED] All 5 methods returned identical results!" << std::endl;
}

int main() {
    // 1. Автоматический тест
    runUnitTest();

    // 2. Ввод данных и вычисления
    int K, N;
    cout << "K = "; cin >> K;
    cout << "N = "; cin >> N;

    cout << "(iter)         S0 = " << S0(K, N) << endl;
    cout << "(rec up +)     S1 = " << S1(K, N, K) << endl;
    cout << "(rec up -)     S2 = " << S2(K, N, N) << endl;
    cout << "(rec down ++)  S3 = " << S3(K, N, K, 0) << endl;
    cout << "(rec down --)  S4 = " << S4(K, N, N, 0) << endl;

    return 0;
}
